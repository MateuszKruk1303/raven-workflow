{
  "schema_version": 2,
  "skills": [
    "raven-agents-md",
    "raven-architecture",
    "raven-auto-implement",
    "raven-auto-plan",
    "raven-auto-test",
    "raven-browser",
    "raven-create-skill",
    "raven-domain-distillation",
    "raven-frame",
    "raven-github-setup",
    "raven-hooks",
    "raven-implement",
    "raven-implement-review",
    "raven-init-stack",
    "raven-jira-roadmap",
    "raven-lesson",
    "raven-manual-qa",
    "raven-md",
    "raven-medusa-ecommerce-init",
    "raven-merge",
    "raven-plan",
    "raven-plan-review",
    "raven-pr",
    "raven-prd",
    "raven-repo-map",
    "raven-research",
    "raven-roadmap",
    "raven-rule-review",
    "raven-shape",
    "raven-test",
    "raven-test-plan",
    "raven-test-review",
    "raven-workflow"
  ],
  "roles": {
    "planner": {
      "model": "gpt-6-astra",
      "effort": "high"
    },
    "reviewer": {
      "model": "gpt-6-astra",
      "effort": "high"
    },
    "tester": {
      "model": "gpt-6-astra",
      "effort": "high"
    },
    "implementer": {
      "model": "gpt-6.1-sol",
      "effort": "low"
    }
  },
  "initial_artifacts": [
    "requirements",
    "plan_accepted",
    "publication_requested",
    "merge_requested",
    "ci_passed",
    "user_acceptance",
    "issue_started"
  ],
  "stages": [
    {
      "id": "plan",
      "skills": [
        "raven-plan",
        "raven-auto-plan"
      ],
      "role": "planner",
      "requires": [
        "requirements",
        "issue_started"
      ],
      "produces": [
        "plan_contract"
      ]
    },
    {
      "id": "plan_review",
      "skills": [
        "raven-plan-review",
        "raven-auto-plan"
      ],
      "role": "reviewer",
      "requires": [
        "plan_contract"
      ],
      "produces": [
        "plan_review"
      ],
      "fresh_context": true
    },
    {
      "id": "pr",
      "skills": [
        "raven-pr"
      ],
      "role": "implementer",
      "requires": [
        "plan_contract",
        "publication_requested"
      ],
      "produces": [
        "pull_request"
      ],
      "side_operation": true,
      "early_draft": true
    },
    {
      "id": "implement",
      "skills": [
        "raven-implement",
        "raven-auto-implement"
      ],
      "role": "implementer",
      "requires": [
        "plan_contract",
        "plan_review",
        "plan_accepted",
        "issue_started"
      ],
      "produces": [
        "implementation",
        "test_evidence"
      ]
    },
    {
      "id": "code_review",
      "skills": [
        "raven-implement-review",
        "raven-auto-implement"
      ],
      "role": "reviewer",
      "requires": [
        "plan_contract",
        "implementation",
        "test_evidence"
      ],
      "produces": [
        "code_review"
      ],
      "fresh_context": true,
      "covers": [
        "requirements",
        "code",
        "tests"
      ]
    },
    {
      "id": "merge",
      "skills": [
        "raven-merge"
      ],
      "role": "implementer",
      "requires": [
        "pull_request",
        "plan_accepted",
        "code_review",
        "test_evidence",
        "ci_passed",
        "merge_requested",
        "user_acceptance"
      ],
      "produces": [
        "merged_pr",
        "issue_done"
      ]
    }
  ],
  "source_of_truth": {
    "change": "context/changes/<id>/plan.md",
    "history": "git",
    "configuration": ".raven/config.json",
    "collaboration": "pull_request",
    "tracker": "github_issues",
    "roadmap": "github_issues"
  },
  "invariants": {
    "acceptance": "contract_fingerprint",
    "progress_invalidates_acceptance": false,
    "tests_with_implementation": true,
    "mandatory_task_issues": true,
    "full_history_read_required": false,
    "deploy_separate": true,
    "normal_implementation_independent_reviews": 1,
    "issue_started_before_plan_or_implementation": true,
    "issue_done_after_merge": true,
    "project_optional": true
  },
  "optional_workflows": {
    "additional_validation": {
      "skills": [
        "raven-manual-qa",
        "raven-test",
        "raven-auto-test",
        "raven-test-review"
      ],
      "trigger": "risk_or_explicit_request"
    }
  }
}
