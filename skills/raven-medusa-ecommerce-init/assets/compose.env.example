# Template only: generate the real ignored .env with fresh local credentials.
COMPOSE_PROJECT_NAME=replace-with-project-and-stable-local-suffix
# Verify compatibility and pin the resolved tag/digest during initialization.
# The accompanying PostgreSQL mount layout supports <=17, not 18+.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_DB=medusa_local
POSTGRES_PORT=5432
REDIS_PORT=6379
